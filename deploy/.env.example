# 复制为 .env 并填充实际值

# ========== 数据库配置 ==========
# 管理员账号（postgres 镜像创建为超级用户）
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=your-admin-password
# 业务账号（应用连接用，最小权限）
DB_NAME=work
DB_USER=work
DB_PASSWORD=work
# 宿主机映射端口（仅本地调试需要改动，容器内固定 5432）
DB_PORT_HOST=5432

# ========== 应用配置 ==========
CHINA_WORKDAY_API_TOKEN=your-token
CHINA_WORKDAY_CRAWL_ENABLED=true
CHINA_WORKDAY_CRAWL_ON_STARTUP=true
CHINA_WORKDAY_CRAWL_CRON=0 0 8 * * *
CHINA_WORKDAY_CRAWL_SEARCH_URL=https://sousuo.www.gov.cn/search-gov/data
CHINA_WORKDAY_CRAWL_SEARCH_KEYWORD=部分节假日安排的通知
CHINA_WORKDAY_CRAWL_YEAR_BACK_OFFSET=1
CHINA_WORKDAY_CRAWL_YEAR_FORWARD_OFFSET=1
